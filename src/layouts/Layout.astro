---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
 	<head>
 		<meta charset="UTF-8" />
 		<meta name="viewport" content="width=device-width" />
 		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
 		<link rel="preconnect" href="https://fonts.googleapis.com">
 		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
 		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
 		<meta name="generator" content={Astro.generator} />
 		<title>A.P.O.L.L.O. Organization</title>
 		<meta name="description" content="A group of friends passionate about building, learning, and experimenting with code." />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
 	html,
 	body {
 		margin: 0;
 		width: 100%;
 		min-height: 100vh;
 		font-family: 'JetBrains Mono', 'Fira Code', 'Source Code Pro', 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
 		line-height: 1.6;
 		color: #f9fafb;
 		background: #111827;
 	}

	main {
		min-height: calc(100vh - 200px); /* Adjust based on header/footer height */
	}
</style>
