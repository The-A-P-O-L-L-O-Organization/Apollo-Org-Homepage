---
// Footer component
---

<footer id="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-section">
        <h3>A.P.O.L.L.O.</h3>
        <p>Advancing open-source projects and fostering innovation in technology.</p>
      </div>
      <div class="footer-section">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/about">About Us</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/team">Team</a></li>
          <li><a href="/blog">Blog</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>Community</h4>
        <ul>
          <li><a href="/docs">Documentation</a></li>
          <li><a href="/contributing">Contributing</a></li>
          <li><a href="/code-of-conduct">Code of Conduct</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>Connect</h4>
        <div class="social-links">
          <a href="https://github.com/The-A.P.O.L.L.O.-Organization" target="_blank" rel="noopener">GitHub</a>
          <a href="mailto:contact@apollo.org">Email</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2025 A.P.O.L.L.O. Organization. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  #footer {
    background: #111827;
    color: white;
    padding: 2rem 0 1rem;
  }

  #footer .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .footer-section h3 {
    margin: 0 0 1rem 0;
    font-size: 1.5rem;
    color: #f3f4f6;
  }

  .footer-section h4 {
    margin: 0 0 1rem 0;
    font-size: 1.125rem;
    color: #f3f4f6;
  }

  .footer-section p {
    color: #9ca3af;
    line-height: 1.6;
  }

  .footer-section ul {
    list-style: none;
    padding: 0;
  }

  .footer-section li {
    margin-bottom: 0.5rem;
  }

  .footer-section a {
    color: #9ca3af;
    text-decoration: none;
    transition: color 0.3s;
  }

  .footer-section a:hover {
    color: #f3f4f6;
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }

  .footer-bottom {
    border-top: 1px solid #374151;
    padding-top: 1rem;
    text-align: center;
  }

  .footer-bottom p {
    margin: 0;
    color: #9ca3af;
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
    }
  }
</style>