---
import Layout from '../../layouts/Layout.astro';
import teamData from '../../data/team.json';

export async function getStaticPaths() {
  return teamData.map(member => ({
    params: { id: member.id },
    props: { member }
  }));
}

const { member } = Astro.props;
---

<Layout>
  <section id="member-hero">
    <div class="container">
      <img src={member.avatar} alt={member.name} class="avatar">
      <h1>{member.name}</h1>
      <p class="role">{member.role}</p>
      <p class="team">Team: {member.team}</p>
    </div>
  </section>

  <section id="member-bio">
    <div class="container">
      <h2>About {member.name}</h2>
      <p>{member.bio}</p>
    </div>
  </section>

  <section id="member-social">
    <div class="container">
      <h2>Connect</h2>
      <div class="social-links">
        {member.social.github && <a href={member.social.github} target="_blank" rel="noopener">GitHub</a>}
        {member.social.twitter && <a href={member.social.twitter} target="_blank" rel="noopener">Twitter</a>}
        {member.social.linkedin && <a href={member.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
        {member.social.dribbble && <a href={member.social.dribbble} target="_blank" rel="noopener">Dribbble</a>}
      </div>
    </div>
  </section>
</Layout>

<style>
  #member-hero {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 4rem 0;
    text-align: center;
  }

  #member-hero .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .avatar {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    margin-bottom: 1rem;
  }

  #member-hero h1 {
    font-size: 3rem;
    margin: 0 0 0.5rem 0;
  }

  .role {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
  }

  .team {
    font-size: 1.125rem;
    margin: 0;
  }

  #member-bio, #member-social {
    padding: 4rem 0;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1rem;
    text-align: center;
  }

  h2 {
    font-size: 2.5rem;
    margin: 0 0 2rem 0;
    color: #111827;
  }

  p {
    font-size: 1.125rem;
    color: #4b5563;
    line-height: 1.6;
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 2rem;
  }

  .social-links a {
    color: #2563eb;
    text-decoration: none;
    font-weight: 600;
  }

  .social-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    #member-hero h1 {
      font-size: 2rem;
    }
    .avatar {
      width: 100px;
      height: 100px;
    }
    .social-links {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>