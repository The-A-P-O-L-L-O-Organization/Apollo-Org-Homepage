---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<section id="about-hero">
		<div class="container">
 			<h1>About A.P.O.L.L.O.</h1>
 			<p>We're a group of friends and collaborators passionate about building, learning, and experimenting with code.</p>
		</div>
	</section>

	<section id="background">
		<div class="container">
			<h2>Our Background</h2>
 			<p>The A.P.O.L.L.O. Organization is our shared space for projects, ideas, and open-source adventures. We're a close-knit team of developers, tech enthusiasts, and friends united by curiosity, creativity, and a love for technology.</p>
 			<p>Our name, A.P.O.L.L.O., stands for "Advancing Projects through Open-source Leadership and Learning Opportunities," but really, it's just a cool acronym that represents our journey of learning and building together.</p>
		</div>
	</section>

	<section id="mission-values">
		<div class="container">
			<div class="mission-values-grid">
				<div class="mission">
 					<h2>Our Mission</h2>
 					<p>To have fun building software projects, learn new technologies together, and share our code and knowledge with the world.</p>
				</div>
				<div class="values">
					<h2>Our Values</h2>
 					<ul>
 						<li><strong>Fun:</strong> Enjoying the process of coding and learning.</li>
 						<li><strong>Friendship:</strong> Supporting each other as friends and collaborators.</li>
 						<li><strong>Curiosity:</strong> Always exploring new tools and ideas.</li>
 						<li><strong>Sharing:</strong> Openly sharing code, resources, and knowledge.</li>
 						<li><strong>Growth:</strong> Helping each other improve as coders and creators.</li>
 					</ul>
				</div>
			</div>
		</div>
	</section>

	<section id="achievements">
		<div class="container">
			<h2>Recent Achievements</h2>
 			<div class="achievements-grid">
 				<div class="achievement">
 					<h3>12+ Repositories</h3>
 					<p>From hobby apps to utilities and learning exercises.</p>
 				</div>
 				<div class="achievement">
 					<h3>Friends First</h3>
 					<p>A supportive group of collaborators who enjoy coding together.</p>
 				</div>
 				<div class="achievement">
 					<h3>Learning Journey</h3>
 					<p>Constantly experimenting with new tech and sharing discoveries.</p>
 				</div>
 				<div class="achievement">
 					<h3>Open Adventures</h3>
 					<p>Building projects that might help others or just for fun.</p>
 				</div>
 			</div>
		</div>
	</section>

	<section id="join-us">
		<div class="container">
 			<h2>Get Involved</h2>
 			<p>Feel free to follow our public repos and watch for updates. Interested in collaborating? Reach out via issues or discussions! Feedback and ideas are always welcome.</p>
			<a href="/Apollo-Org-Homepage/contributing" class="btn primary">Start Contributing</a>
		</div>
	</section>
</Layout>

<style>
	#about-hero {
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		color: white;
		padding: 4rem 0;
		text-align: center;
	}

	#about-hero .container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	#about-hero h1 {
		font-size: 3rem;
		margin: 0 0 1rem 0;
	}

	#about-hero p {
		font-size: 1.25rem;
		margin: 0;
	}

	#background, #mission-values, #achievements, #join-us {
		padding: 4rem 0;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}

 	h2 {
 		font-size: 2.5rem;
 		margin: 0 0 2rem 0;
 		color: #f9fafb;
 		text-align: center;
 	}

 	p {
 		font-size: 1.125rem;
 		color: #d1d5db;
 		line-height: 1.6;
 	}

	.mission-values-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		margin-top: 2rem;
	}

	.mission h2, .values h2 {
		text-align: left;
		margin-bottom: 1rem;
	}

	.values ul {
		list-style: none;
		padding: 0;
	}

	.values li {
		margin-bottom: 1rem;
		font-size: 1.125rem;
	}

	.values strong {
		color: #111827;
	}

	.achievements-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
		margin-top: 2rem;
	}

 	.achievement {
 		background: #1f2937;
 		padding: 2rem;
 		border-radius: 0.5rem;
 		box-shadow: 0 4px 6px rgba(0,0,0,0.3);
 		text-align: center;
 	}

 	.achievement h3 {
 		margin: 0 0 1rem 0;
 		color: #f9fafb;
 	}

 	.achievement p {
 		margin: 0;
 		color: #d1d5db;
 	}

 	#join-us {
 		background: #0f172a;
 		text-align: center;
 	}

	#join-us p {
		max-width: 600px;
		margin: 0 auto 2rem;
	}

	.btn {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		text-decoration: none;
		border-radius: 0.5rem;
		font-weight: 600;
		transition: all 0.3s;
		background: #2563eb;
		color: white;
	}

	.btn:hover {
		background: #1d4ed8;
	}

	@media (max-width: 768px) {
		#about-hero h1 {
			font-size: 2rem;
		}
		.mission-values-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.achievements-grid {
			grid-template-columns: 1fr;
		}
	}
</style>