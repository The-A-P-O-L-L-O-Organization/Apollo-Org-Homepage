---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<section id="hero">
		<div class="container">
 			<h1>Welcome to A.P.O.L.L.O.</h1>
 			<p>We're a group of friends passionate about building, learning, and experimenting with code. Together, we reach for the stars!</p>
 			<div class="cta-buttons">
				<a href="/Apollo-Org-Homepage/projects" class="btn primary">Explore Projects</a>
				<a href="/Apollo-Org-Homepage/about" class="btn secondary">Learn More</a>
			</div>
		</div>
	</section>

	<section id="mission">
		<div class="container">
 			<h2>Our Mission</h2>
 			<p>To create a fun, collaborative space where friends and tech enthusiasts can build projects, learn new things, and share our coding adventures with the world.</p>
		</div>
	</section>

	<section id="highlights">
		<div class="container">
			<h2>Key Highlights</h2>
 			<div class="highlights-grid">
 				<div class="highlight-card">
 					<h3>12+ Repositories</h3>
 					<p>From hobby apps to utilities and learning exercises.</p>
 				</div>
 				<div class="highlight-card">
 					<h3>Friends & Collaborators</h3>
 					<p>A close-knit team united by curiosity and creativity.</p>
 				</div>
 				<div class="highlight-card">
 					<h3>Fun Learning</h3>
 					<p>Experimenting with new tech and sharing knowledge.</p>
 				</div>
 			</div>
		</div>
	</section>

	<section id="cta">
		<div class="container">
 			<h2>Get Involved</h2>
 			<p>Follow our repos, collaborate on projects, or just say hi! Feedback and ideas are always welcome.</p>
			<a href="/Apollo-Org-Homepage/contributing" class="btn primary">Get Started</a>
		</div>
	</section>
</Layout>

<style>
	#hero {
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		color: white;
		padding: 4rem 0;
		text-align: center;
	}

	#hero .container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	#hero h1 {
		font-size: 3rem;
		margin: 0 0 1rem 0;
	}

	#hero p {
		font-size: 1.25rem;
		margin: 0 0 2rem 0;
	}

	.cta-buttons {
		display: flex;
		justify-content: center;
		gap: 1rem;
	}

	.btn {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		text-decoration: none;
		border-radius: 0.5rem;
		font-weight: 600;
		transition: all 0.3s;
	}

	.btn.primary {
		background: #2563eb;
		color: white;
	}

	.btn.primary:hover {
		background: #1d4ed8;
	}

	.btn.secondary {
		background: transparent;
		color: white;
		border: 2px solid white;
	}

	.btn.secondary:hover {
		background: white;
		color: #667eea;
	}

	#mission, #highlights, #cta {
		padding: 4rem 0;
	}

	#mission .container, #highlights .container, #cta .container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
		text-align: center;
	}

	#mission h2, #highlights h2, #cta h2 {
		font-size: 2.5rem;
		margin: 0 0 1rem 0;
		color: #111827;
	}

	#mission p {
		font-size: 1.125rem;
		color: #4b5563;
		max-width: 600px;
		margin: 0 auto;
	}

	.highlights-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
		margin-top: 2rem;
	}

	.highlight-card {
		background: white;
		padding: 2rem;
		border-radius: 0.5rem;
		box-shadow: 0 4px 6px rgba(0,0,0,0.1);
	}

	.highlight-card h3 {
		margin: 0 0 1rem 0;
		color: #111827;
	}

	.highlight-card p {
		color: #4b5563;
		margin: 0;
	}

	#cta {
		background: #f9fafb;
	}

	#cta p {
		font-size: 1.125rem;
		color: #4b5563;
		margin: 0 0 2rem 0;
	}

	@media (max-width: 768px) {
		#hero h1 {
			font-size: 2rem;
		}
		.cta-buttons {
			flex-direction: column;
			align-items: center;
		}
		.highlights-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
